{
  "hooks": {
    "PreToolUse": [
      { "matcher": "mcp__.*", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__.*Microsoft_365__.*", "hooks": [ { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/record.sh" } ] }
    ]
  }
}
