#!/bin/bash
# Print the weekly-roundup config as JSON with defaults merged in and ~ expanded.
# Config: $WEEKLY_ROUNDUP_CONFIG or ~/.config/weekly-roundup/config.json. Needs only jq.
# Exits non-zero if the config is missing or invalid, so callers can fail closed.
set -euo pipefail
path=${WEEKLY_ROUNDUP_CONFIG:-$HOME/.config/weekly-roundup/config.json}
[ -f "$path" ] || { echo "weekly-roundup: no config at $path" >&2; exit 1; }
jq -e --arg home "$HOME" '
  def deep(a; b): a as $a | b as $b
    | if ($a|type)=="object" and ($b|type)=="object"
      then reduce ($b|keys_unsorted[]) as $k ($a; .[$k] = deep($a[$k]; $b[$k]))
      else $b end;
  def tilde: if type=="string" then sub("^~"; $home) else . end;
  deep({
    week_start_day: "sunday",
    transcripts_dir: "~/.claude/projects",
    skip_projects: [], repos: [], github_repos: [],
    caps: {findings_per_source: 40, transcript_kb: 96, clerk_kb: 60, commits_per_repo: 100},
    budgets: {outlook_email_search: 30, read_resource: 40, outlook_calendar_search: 4,
              chat_message_search: 24, teams_list_chats: 2, teams_list_teams: 1,
              teams_list_channels: 5, teams_list_channel_messages: 10, sharepoint_search: 5,
              search_people: 10, get_me: 2, default: 3, total_kb: 1024},
    max_window_days: 8, gap_days: 14,
    m365: {include_self_chat: true, noise_senders: [], mute_chats: [], alert_patterns: [], my_addresses: []}
  }; .)
  | .log_dir |= tilde | .rules_file |= tilde | .team_rules_file |= tilde
  | .clerk_dir |= tilde | .transcripts_dir |= tilde | .log_template |= tilde
  | .repos |= map(tilde)
  | with_entries(select(.value != null))
  # Validate: a bad value must fail loudly, never loosen a limit.
  | def int_in(lo; hi): type == "number" and . == floor and . >= lo and . <= hi;
    def strs: type == "array" and all(.[]; type == "string");
    [ (if (.log_dir | type) != "string" then "log_dir must be a path" else empty end),
      (if (.rules_file | type) != "string" then "rules_file must be a path" else empty end),
      (if (.team_rules_file // "" | type) != "string" then "team_rules_file must be a path" else empty end),
      (if (.week_start_day | IN("sunday","monday","tuesday","wednesday","thursday","friday","saturday")) | not then "week_start_day must be a weekday name" else empty end),
      (if (.max_window_days | int_in(1; 31)) | not then "max_window_days must be a whole number from 1 to 31" else empty end),
      (if (.gap_days | int_in(1; 366)) | not then "gap_days must be a whole number from 1 to 366" else empty end),
      (if (.budgets | type) != "object" then "budgets must be an object of tool: calls"
       else (.budgets | del(.total_kb) | to_entries[] | select(.value | int_in(0; 1000) | not) | "budgets.\(.key) must be a whole number from 0 to 1000"),
            (if (.budgets.total_kb | int_in(1; 100000)) | not then "budgets.total_kb must be a whole number from 1 to 100000" else empty end) end),
      (if (.caps | type) != "object" then "caps must be an object of name: limit"
       else (.caps | to_entries[] | select(.value | int_in(1; 100000) | not) | "caps.\(.key) must be a whole number from 1 to 100000") end),
      (if (.transcripts_dir | type) != "string" then "transcripts_dir must be a path" else empty end),
      (.clerk_dir, .log_template | select(. != null and type != "string") | "clerk_dir and log_template must be paths"),
      (if (.repos | strs) and (.github_repos | strs) and (.skip_projects | strs) then empty else "repos, github_repos and skip_projects must be lists of strings" end),
      (if (.m365 | type) != "object" then "m365 must be an object"
       else (if (.m365.noise_senders | strs) and (.m365.mute_chats | strs) and (.m365.alert_patterns | strs) and (.m365.my_addresses | strs) then empty else "m365 lists must be lists of strings" end),
            (.m365.mute_chats[]? | strings | select(test("^[0-9]+:[^ ]+$") | not) | "m365.mute_chats takes chat IDs (like 19:abc@thread.v2), not names: \(.)"),
            (if (.m365.include_self_chat | type) != "boolean" then "m365.include_self_chat must be true or false" else empty end) end)
    ] as $errs
  | if ($errs | length) > 0 then ("invalid config: " + ($errs | join("; ") + "\n") | halt_error(1)) else . end
' "$path"
